#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

IDI_APPICON ICON "assets/icon.ico"

1 VERSIONINFO
FILEVERSION WXNEUR_VERSION_COMMA
PRODUCTVERSION WXNEUR_VERSION_COMMA
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x2L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904B0"
        BEGIN
            VALUE "CompanyName", WXNEUR_AUTHOR
            VALUE "FileDescription", "wxneur — переключатель раскладки клавиатуры"
            VALUE "FileVersion", WXNEUR_VERSION_STR
            VALUE "InternalName", WXNEUR_PRODUCT
            VALUE "LegalCopyright", WXNEUR_COPYRIGHT
            VALUE "OriginalFilename", "wxneur.exe"
            VALUE "ProductName", WXNEUR_PRODUCT
            VALUE "ProductVersion", WXNEUR_VERSION_STR
            VALUE "Comments", "GNU GPL v3 or later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END

IDD_ABOUT DIALOGEX 0, 0, 280, 148
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "О программе"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON IDI_APPICON, -1, 12, 12, 20, 20
    LTEXT "wxneur 0.985 beta", -1, 44, 12, 220, 12
    LTEXT "Автор: Tap3ah", -1, 44, 26, 220, 10
    LTEXT "Автоматический переключатель раскладки EN/RU для Windows.", -1, 12, 48, 256, 18
    LTEXT "Лицензия: GNU GPL версии 3 или более поздней", -1, 12, 70, 256, 10
    LTEXT "Словари: FrequencyWords (CC-BY-SA-4.0), эвристики xneur (GPL-2.0+).", -1, 12, 84, 256, 20
    LTEXT WXNEUR_COPYRIGHT, -1, 12, 108, 256, 10
    DEFPUSHBUTTON "ОК", IDOK, 218, 126, 50, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 360, 386
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Параметры wxneur"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX "Включено", IDC_CHK_ENABLED, 12, 10, 160, 12
    AUTOCHECKBOX "Автопереключение раскладки", IDC_CHK_AUTO, 12, 24, 200, 12
    AUTOCHECKBOX "Игнорировать поля пароля", IDC_CHK_PASSWORD, 12, 38, 200, 12
    AUTOCHECKBOX "Запускать вместе с Windows", IDC_CHK_AUTOSTART, 12, 52, 200, 12

    LTEXT "Минимальная длина слова:", -1, 12, 72, 140, 10
    EDITTEXT IDC_EDIT_MINLEN, 156, 70, 28, 12, ES_NUMBER | ES_AUTOHSCROLL

    GROUPBOX "Горячие клавиши", -1, 8, 88, 344, 96
    LTEXT "Ctrl", -1, 148, 98, 22, 8
    LTEXT "Alt", -1, 176, 98, 20, 8
    LTEXT "Shift", -1, 202, 98, 28, 8
    LTEXT "Клавиша", -1, 248, 98, 50, 8

    LTEXT "Конвертировать слово:", -1, 16, 112, 128, 10
    AUTOCHECKBOX "", IDC_CHK_CONVERT_CTRL, 150, 110, 18, 12
    AUTOCHECKBOX "", IDC_CHK_CONVERT_ALT, 178, 110, 18, 12
    AUTOCHECKBOX "", IDC_CHK_CONVERT_SHIFT, 206, 110, 18, 12
    COMBOBOX IDC_CMB_CONVERT, 236, 108, 108, 140, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT "Конвертировать выделение:", -1, 16, 128, 128, 10
    AUTOCHECKBOX "", IDC_CHK_SEL_CTRL, 150, 126, 18, 12
    AUTOCHECKBOX "", IDC_CHK_SEL_ALT, 178, 126, 18, 12
    AUTOCHECKBOX "", IDC_CHK_SEL_SHIFT, 206, 126, 18, 12
    COMBOBOX IDC_CMB_SEL, 236, 124, 108, 140, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT "Добавить в словарь:", -1, 16, 144, 128, 10
    AUTOCHECKBOX "", IDC_CHK_LEARN_CTRL, 150, 142, 18, 12
    AUTOCHECKBOX "", IDC_CHK_LEARN_ALT, 178, 142, 18, 12
    AUTOCHECKBOX "", IDC_CHK_LEARN_SHIFT, 206, 142, 18, 12
    COMBOBOX IDC_CMB_LEARN, 236, 140, 108, 140, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT "Отменить конвертацию:", -1, 16, 160, 128, 10
    AUTOCHECKBOX "", IDC_CHK_UNDO_CTRL, 150, 158, 18, 12
    AUTOCHECKBOX "", IDC_CHK_UNDO_ALT, 178, 158, 18, 12
    AUTOCHECKBOX "", IDC_CHK_UNDO_SHIFT, 206, 158, 18, 12
    COMBOBOX IDC_CMB_UNDO, 236, 156, 108, 140, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT "Исключённые процессы (по одному в строке):", -1, 12, 192, 280, 10
    EDITTEXT IDC_EDIT_EXCLUDED, 12, 204, 336, 28, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT "Английский словарь:", -1, 12, 238, 160, 10
    EDITTEXT IDC_EDIT_EXTRA_EN, 12, 250, 164, 36, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "Русский словарь:", -1, 184, 238, 160, 10
    EDITTEXT IDC_EDIT_EXTRA_RU, 184, 250, 164, 36, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT "Словарь исключений (не переключать эти слова):", -1, 12, 292, 300, 10
    EDITTEXT IDC_EDIT_EXCEPTIONS, 12, 304, 336, 36, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "Встроенные правила xneur: http, ftp, www, IP, MAC, .рф, частицы а/в/и/к/ну/о/у/я.", -1, 12, 344, 336, 10

    LTEXT "wxneur 0.985 beta · автор Tap3ah · GNU GPL v3+", -1, 12, 366, 230, 10
    DEFPUSHBUTTON "ОК", IDOK, 248, 364, 50, 14
    PUSHBUTTON "Отмена", IDCANCEL, 302, 364, 50, 14
END
